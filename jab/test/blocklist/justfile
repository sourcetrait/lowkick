# A Jab program. Every recipe hands off to the SDK's nushell tool, found
# through the manifest's `sdk`, which reads program.jab.toml and does the
# lookups (workspace, toolchain, target, kernel, display) and the
# up-to-date check. Standalone, with no workspace above, JAB_KERNEL names
# the kernel ELF to run on.

set shell := ["nu", "-c"]
set windows-shell := ["nu", "-c"]
set quiet := true

here := justfile_directory()

default: build

# Assemble and link src/main.S to <target>/<path>/<name>.jab when stale
build:
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") build "{{here}}"

# Build, then run test/test.nu on the kernel
test:
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") test "{{here}}"

# Build, then run on the kernel with the console window, the UART on
# stdio; the exit code is the program's status
run:
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") run "{{here}}"

clean:
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") clean "{{here}}"
