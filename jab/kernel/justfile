# The Jab kernel. Every recipe hands off to the SDK's nushell tool, found
# through the manifest's `sdk`, which reads kernel.jab.toml and does the
# lookups (workspace, toolchain, target) and the up-to-date check.
# JAB_DEBUG=1 in the environment assembles the kernel's own UART lines in.

set shell := ["nu", "-c"]
set windows-shell := ["nu", "-c"]
set quiet := true

here := justfile_directory()

default: build

# Assemble src/*.S and link them to <target>/kernel/jab.elf when stale
build:
    let sdk = (open kernel.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") build --kernel "{{here}}"

clean:
    let sdk = (open kernel.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") clean --kernel "{{here}}"

# Regenerate src/font.S, the console font, from a Spleen 12x24 BDF:
# `just font <spleen-12x24.bdf>`
font bdf:
    ^nu font/spleen.nu "{{bdf}}" src/font.S
