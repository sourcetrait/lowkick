# A Jab program. Builds src/main.S into <target>/prog/<name>/<name>.jab
# and runs it on the kernel built at <target>/kernel/jab.elf.
#
# Lookups, in order: the workspace is the nearest parent directory
# holding workspace.jab.toml, if any; the toolchain is RISCV_TOOLCHAIN,
# else extern/riscv here, else the workspace's extern/riscv, else the
# tools on PATH; the target is the workspace's .target, else .target
# here; the name, include paths, and link script come from
# program.jab.toml. Paths must not contain spaces.

set shell := ["nu", "-c"]
set windows-shell := ["nu", "-c"]

here := justfile_directory()
manifest := here / "program.jab.toml"
triple := "riscv64-unknown-linux-gnu-"

workspace_dir := shell('mut d = "' + here + '"; mut found = ""; loop { if ($d | path join "workspace.jab.toml" | path exists) { $found = $d; break }; let p = ($d | path dirname); if $p == $d { break }; $d = $p }; print -n $found')
riscv_toolchain := if env("RISCV_TOOLCHAIN", "") != "" { env("RISCV_TOOLCHAIN") } else { if path_exists(here / "extern" / "riscv") == "true" { here / "extern" / "riscv" } else { if workspace_dir != "" { if path_exists(workspace_dir / "extern" / "riscv") == "true" { workspace_dir / "extern" / "riscv" } else { "" } } else { "" } } }
riscv_tool := if riscv_toolchain != "" { riscv_toolchain / "bin" / triple } else { triple }
asm := riscv_tool + "as"
link := riscv_tool + "ld"
objcopy := riscv_tool + "objcopy"
target := if workspace_dir != "" { workspace_dir / ".target" } else { here / ".target" }
name := shell('open "' + manifest + '" | get name | print -n $in')
includes := shell('open "' + manifest + '" | get -o includes | default [] | each {|p| $"-I ($p)" } | str join " " | print -n $in')
link_script := shell('open "' + manifest + '" | get link | print -n $in')
expect := shell('open "' + manifest + '" | get -o expect | default 0 | print -n $in')
out := target / "prog" / name
image := out / name + ".jab"
kernel_elf := target / "kernel" / "jab.elf"

qemu := "qemu-system-riscv64"
program_base := "0x80800000"
machine := "-machine virt -cpu rv64 -accel tcg -smp 4 -global virtio-mmio.force-legacy=false"
devices := "-device virtio-gpu-device,xres=1920,yres=1080 -device virtio-keyboard-device -device virtio-tablet-device -device virtio-net-device,netdev=net0 -netdev user,id=net0 -device virtio-sound-device,audiodev=snd0 -audiodev none,id=snd0 -device virtio-rng-device"

default: build

# Assemble and link src/main.S, then flatten it to <name>.jab
build:
    mkdir "{{out}}"
    ^"{{asm}}" {{includes}} src/main.S -o "{{out}}/{{name}}.o"
    ^"{{link}}" -T {{link_script}} -nostdlib "{{out}}/{{name}}.o" -o "{{out}}/{{name}}.elf"
    ^"{{objcopy}}" -O binary "{{out}}/{{name}}.elf" "{{image}}"

# Run headless for up to `seconds`, the UART to <out>/serial.log, and
# compare the run's status with the manifest's `expect` (0 by default):
# exits 0 on a match, else 1. The status is what jab.exit gave, 1 on a
# program fault, 124 when the bound ended the run.
test seconds="10": build
    if not ("{{kernel_elf}}" | path exists) { error make {msg: "no kernel at {{kernel_elf}}; build the kernel first"} }
    let status = (^timeout --signal=TERM {{seconds}} {{qemu}} {{machine}} -m 128M -bios none -kernel {{kernel_elf}} -device loader,file={{image}},addr={{program_base}},force-raw=on -display none -monitor none -serial file:{{out}}/serial.log | complete | get exit_code); print -n (open --raw "{{out}}/serial.log"); if $status == {{expect}} { print $"{{name}}: status ($status) as expected" } else { print $"{{name}}: status ($status), expected {{expect}}"; exit 1 }

# Run with the console window and the full virtio device set, the UART on stdio
run: build
    if not ("{{kernel_elf}}" | path exists) { error make {msg: "no kernel at {{kernel_elf}}; build the kernel first"} }
    if not ("{{target}}/disk.img" | path exists) { ^truncate -s 64M "{{target}}/disk.img" }
    ^{{qemu}} {{machine}} -m 4G {{devices}} -drive if=none,id=disk0,file={{target}}/disk.img,format=raw -device virtio-blk-device,drive=disk0 -bios none -kernel {{kernel_elf}} -device loader,file={{image}},addr={{program_base}},force-raw=on -display default -serial stdio -monitor none

clean:
    rm -rf "{{out}}"
