# Jab system calls: the table of record. The number goes in a7, each
# argument in the register named, then `ecall`; the result comes back in
# a0, and a second one in a1 where a call has two. `kind` is how the SDK
# macro takes the argument: immediate (a constant, checked where a range
# exists), address (a label), or register (the program loads it before
# the call). sdk/jab.inc carries the same numbers.
[
    [name, number, args, summary];
    [jab.exit, 1, [{name: status, kind: immediate, reg: a0}], "End the program with a status; QEMU exits with it until a launcher exists"],
    [jab.print, 2, [{name: message, kind: address, reg: a0}], "Write a NUL-terminated string inside the program's window to the screen console once the display is open, else to the UART"],
    [jab.uart.print, 3, [{name: message, kind: address, reg: a0}], "Write a NUL-terminated string inside the program's window to the UART"],
    [jab.display.open, 4, [], "Bring the display up and show the framebuffer; 0, or 1 with no virtio-gpu, 2 when the device refuses the kernel, 3 when a command fails"],
    [jab.display.ready, 5, [], "1 when a flip would go through now, 0 while the cap holds it back"],
    [jab.display.flip, 6, [], "Show the framebuffer without waiting; 0, or 1 when early under the cap (nothing shown), 2 when not open, 3 when the device refused"],
    [jab.display.print, 7, [{name: message, kind: address, reg: a0}], "Write a NUL-terminated string inside the program's window to the screen console, opening the display if needed; 0, or jab.display.open's code"],
    [jab.await, 8, [{name: mask, kind: immediate, reg: a0}], "Halt until an event in the mask, 0 for any: the display's frame tick (1), a key event (2), or bytes from the host over the API (4); the events that fired"],
    [jab.display.flip.rect, 9, [{name: x, kind: register, reg: a0}, {name: y, kind: register, reg: a1}, {name: width, kind: register, reg: a2}, {name: height, kind: register, reg: a3}], "Show a rectangle of the framebuffer without waiting; jab.display.flip's codes, plus 4 when the rectangle is empty or reaches outside the screen"],
    [jab.keyboard.input, 10, [], "The next key event: its code (Linux's, sdk/jab_keys.inc) in a0, or 0 with none waiting, and its value in a1, 0 released, 1 pressed, 2 held; brings the keyboard up on the first call"],
    [jab.block.list, 11, [{name: buffer, kind: register, reg: a0}, {name: at, kind: register, reg: a1}, {name: capacity, kind: immediate, reg: a2}], "Write a record per disk into the buffer, starting at the disk with that id and 0 for the first; the records written, and in a1 the id to start the next page at, 0 once the last disk is in the buffer"],
    [jab.block.find, 12, [{name: serial, kind: address, reg: a0}], "The id of the first disk whose serial is that NUL-terminated string, or 0 when no disk carries it"],
    [jab.block.read, 13, [{name: buffer, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: sector, kind: register, reg: a2}, {name: count, kind: register, reg: a3}], "Read that many 512-byte sectors of that disk, from that one, into the buffer; 0, or 1 no such disk, 2 it would not come up, 3 the device reported an error, 4 those sectors are not on it"],
    [jab.block.write, 14, [{name: buffer, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: sector, kind: register, reg: a2}, {name: count, kind: register, reg: a3}], "Write that many 512-byte sectors of the buffer to that disk, from that one; jab.block.read's codes"],
    [jab.romfs.list, 15, [{name: buffer, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: directory, kind: register, reg: a2}, {name: offset, kind: register, reg: a3}, {name: capacity, kind: immediate, reg: a4}], "Write a record per entry of that directory into the buffer, from that offset and 0 for its first entry; the records written, and in a1 the offset to start the next page at, 0 once the directory has ended"],
    [jab.romfs.find, 16, [{name: buffer, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: directory, kind: register, reg: a2}, {name: path, kind: address, reg: a3}], "Look for that path from that directory, a leading / starting at the root, and write the entry's record into the buffer; 0 found, 1 nothing of that name, 2 a component along the way is not a directory, with the entry's own offset in a1"],
    [jab.romfs.read, 17, [{name: buffer, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: file, kind: register, reg: a2}, {name: offset, kind: register, reg: a3}, {name: length, kind: register, reg: a4}], "Read at most that many bytes of that file, from that byte of it, into the buffer; the bytes written, and in a1 the offset to read from next, 0 at the file's end"],
    [jab.tar.list, 18, [{name: buffer, kind: register, reg: a0}, {name: archive, kind: register, reg: a1}, {name: length, kind: register, reg: a2}, {name: offset, kind: register, reg: a3}, {name: capacity, kind: immediate, reg: a4}], "Write a record per entry of a tar archive the program already holds into the buffer, from that header's offset and 0 for the first; the records written, and in a1 the offset to start the next page at, 0 once the archive has ended"],
    [jab.tar.find, 19, [{name: buffer, kind: register, reg: a0}, {name: archive, kind: register, reg: a1}, {name: length, kind: register, reg: a2}, {name: path, kind: address, reg: a3}], "Look for that path in the archive and write its record into the buffer; 0 found or 1 no such name, with the entry's own offset in a1"],
    [jab.gz.size, 20, [{name: source, kind: register, reg: a0}, {name: length, kind: register, reg: a1}], "The length a gzip's contents will be, from its trailer; a1 JAB_GZ_OK or JAB_GZ_NOT_GZIP"],
    [jab.gz.read, 21, [{name: buffer, kind: register, reg: a0}, {name: source, kind: register, reg: a1}, {name: length, kind: register, reg: a2}, {name: capacity, kind: register, reg: a3}], "Inflate a gzip into the buffer in one call, its CRC-32 and length checked; the bytes written, and a JAB_GZ_* code in a1"],
    [jab.checksum, 22, [{name: address, kind: register, reg: a0}, {name: size, kind: register, reg: a1}], "The SHA3-256 of those bytes, in a0 to a3"],
    [jab.hash, 23, [{name: address, kind: register, reg: a0}, {name: size, kind: register, reg: a1}], "The XXH3-64 of those bytes"],
    [jab.api.write, 24, [{name: buffer, kind: register, reg: a0}, {name: length, kind: register, reg: a1}], "Send that many bytes of the buffer to the host over the API, returning once the device has taken them; 0, or 1 when the machine has no API port"],
    [jab.api.read, 25, [{name: buffer, kind: register, reg: a0}, {name: capacity, kind: immediate, reg: a1}], "The bytes the host has sent over the API, oldest first, into the buffer, at most capacity; the bytes written, 0 with none waiting, and in a1 how many still wait, both 0 with no API port; never waits"]
]
