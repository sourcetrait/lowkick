# LowKick Jab workspace: calls the kernel's and each program's justfile
# in turn, the list coming from workspace.jab.toml. Needs nushell, just,
# a riscv64 GNU toolchain, and qemu-system-riscv64; see kernel/justfile
# for how the toolchain and the target directory are found.

set shell := ["nu", "-c"]
set windows-shell := ["nu", "-c"]

here := justfile_directory()
manifest := here / "workspace.jab.toml"
kernel_dir := shell('open "' + manifest + '" | get kernel | print -n $in')
programs := shell('open "' + manifest + '" | get programs | str join " " | print -n $in')

default: build

# Build the kernel, then every program
build:
    ^just -f "{{here}}/{{kernel_dir}}/justfile" build
    for p in ("{{programs}}" | split row " ") { ^just -f ("{{here}}" | path join $p "justfile") build }

# Build everything, then run every program's headless test against its
# manifest's `expect`; prints each log and a summary, fails if any fails
test seconds="10": build
    let results = ("{{programs}}" | split row " " | each {|p| let r = (^just -f ("{{here}}" | path join $p "justfile") test {{seconds}} | complete); print $"--- ($p)"; print -n $r.stdout; { program: $p, passed: ($r.exit_code == 0) } }); print ($results | table); exit (if ($results | all {|r| $r.passed }) { 0 } else { 1 })

# Run one program by its manifest name with the console window
run name: build
    let p = ("{{programs}}" | split row " " | where {|p| (open ("{{here}}" | path join $p "program.jab.toml") | get name) == "{{name}}" } | first); ^just -f ("{{here}}" | path join $p "justfile") run

clean:
    rm -rf "{{here}}/.target"
